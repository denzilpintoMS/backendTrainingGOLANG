# Copy to .env. These credentials are for local development only.
POSTGRES_DB=books
POSTGRES_USER=books
POSTGRES_PASSWORD=books_local

# Match these credentials to the PostgreSQL instance above.
# Use your provider's TLS settings when connecting to a hosted database.
DATABASE_URL=postgres://books:books_local@localhost:5432/books?sslmode=disable
PORT=8080
JWT_SECRET=mindstack

# Optional: dedicated database URL for the PostgreSQL integration test.
# TEST_DATABASE_URL=postgres://books:books_local@localhost:5432/books?sslmode=disable
